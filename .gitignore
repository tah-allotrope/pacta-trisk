# Engagement & Disclosure Output Layer — generated client-facing artifacts.
# Privacy posture (CON-003): never commit generated letters/disclosure packs.
# The scoring backbone (output/engagement/engagement_priority.csv) IS tracked;
# only the per-borrower letters and the disclosure pack are ignored.
output/engagement_letters/*
!output/engagement_letters/.gitkeep
output/disclosure/*
!output/disclosure/.gitkeep

# Raw per-run TRISK scenario-grid CSVs (~2,900 files per tree). The dashboard
# reads only the consolidated grid artifacts (scenarios.csv,
# borrower_results.parquet, grid_meta.json); raw runs stay local-only.
# CRITICAL: refresh.yml auto-commits with `git add dashboard/data
# synthesis_output` — these entries are what keep CI from re-adding them.
dashboard/data/trisk/grid/*/runs/
synthesis_output/trisk/grid/*/runs/

# Raw per-run TRISK demo outputs (timestamped subdirectories). The dashboard
# and downstream tests read only the *_latest.csv files and the figures/
# folder; the per-sensitivity run folders are local-only build artifacts.
dashboard/data/trisk/*/runs/
synthesis_output/trisk/*/runs/

# Pseudonym mapping from --anonymize intake runs. Operator-held, never committed.
intake/output*/pseudonym_map.csv

# Rehearsal intake outputs (generated during dress rehearsal, not tracked).
intake/output_rehearsal/
intake/output_rehearsal_named/

# Per-engagement generated artifacts (charts, HTML, letters, disclosure,
# private snapshots, raw per-run TRISK folders, intermediate TRISK inputs).
# Only engagement_config.json and the small regression-test artifacts named
# explicitly in each engagement's plan are committed; everything
# bulky/regeneratable stays local-only.
engagements/*/snapshot/
engagements/*/reports/
engagements/*/output/**/figures/
engagements/*/output/engagement_letters/
engagements/*/output/disclosure/
engagements/*/output/trisk/*/runs/
engagements/*/output/trisk_inputs/

# Per-engagement intake intermediates (only the durable regression fixtures are
# tracked: normalized_loanbook.csv, validation_warnings.csv, and
# coverage_metrics.json -- Wave 2 PHASE-05/06).
engagements/*/intake/*
!engagements/sdb-rehearsal/intake/normalized_loanbook.csv
!engagements/sdb-rehearsal/intake/validation_warnings.csv
!engagements/sdb-rehearsal/intake/coverage_metrics.json

# Per-engagement effective config copy.
engagements/*/engagement_config.resolved.json

# Per-engagement output tree: only engagement_priority.csv and the two TRISK
# regression-test CSVs per sector are tracked; everything else is local-only.
engagements/*/output/*
!engagements/*/output/engagement/
!engagements/*/output/trisk/
engagements/*/output/engagement/*
!engagements/sdb-rehearsal/output/engagement/engagement_priority.csv
engagements/*/output/trisk/*/*
!engagements/sdb-rehearsal/output/trisk/*/npv_results_latest.csv
!engagements/sdb-rehearsal/output/trisk/*/company_summary.csv

# Wave 3 PHASE-04: scratch space for the scale-fixture generator and the
# PHASE-03 scenario-vintage comparison's temporary PACTA runs. Never
# committed; local-only build artifacts.
bench/
